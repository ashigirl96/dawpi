#!/bin/sh
# Refuses a commit whose added lines carry machine-local values: this repo is public,
# and a pushed value cannot be taken back. The patterns come from the running machine,
# so this file itself names no user or path.
home=$(printf '%s' "$HOME" | sed 's/[][\.*^$/]/\\&/g')
user=$(id -un | sed 's/[][\.*^$/]/\\&/g')
pattern="${home}|/Users/[A-Za-z0-9._-]+/|\\b${user}\\b|/private/tmp/claude-|/private/var/folders/"
pattern="${pattern}|\\b(10\\.[0-9]{1,3}|192\\.168|172\\.(1[6-9]|2[0-9]|3[01])|100\\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7]))\\.[0-9]{1,3}\\.[0-9]{1,3}\\b"

hits=$(git diff --cached --no-color -U0 --diff-filter=AM -- . ':(exclude).githooks/pre-commit' |
  awk '/^\+\+\+ b\//{f=substr($0,7)} /^\+[^+]/{print f": "substr($0,2)}' |
  grep -E "$pattern" | head -10)
[ -z "$hits" ] && exit 0
echo "pre-commit: 手元の環境の値が入っています。一般名に置き換えてください（home は ~、LAN の IP は「LAN の IP」）。" >&2
printf '%s\n' "$hits" >&2
exit 1
